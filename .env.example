# ===================================================================
# SECBOT - Exemplo de Variaveis de Ambiente Locais
# ATENCAO: NAO coloque credenciais reais ou de producao neste arquivo!
# Copie este arquivo para .env e preencha com seus valores locais.
# ===================================================================

# Conexao com o Banco de Dados MySQL
# Recomenda-se utilizar um usuario dedicado para a aplicacao (ex: secbot_user)
DB_URL=jdbc:mysql://localhost:3306/secbot_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=secbot_user
DB_PASSWORD=sua_senha_mysql_aqui
DB_DRIVER=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect

# Seguranca / JWT
# OBRIGATORIO: Gere uma chave secreta aleatoria e criptograficamente segura para seu ambiente.
# A chave DEVE possuir no minimo 32 caracteres (256 bits).
# Sugestoes para gerar uma chave aleatoria localmente:
#   No PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { [byte](Get-Random -Minimum 0 -Maximum 256) }))
#   No Bash/Linux: openssl rand -base64 32
# ATENCAO: O valor abaixo e apenas um marcador de posicao ilustrativo e DEVE ser substituido.
JWT_SECRET=COLOQUE_AQUI_SUA_CHAVE_SECRETA_ALEATORIA_GERADA_LOCALMENTE_MINIMO_32_CARACTERES
JWT_EXPIRATION=36000000
