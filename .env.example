# ===================================================================
# SECBOT - Exemplo de Variaveis de Ambiente Locais
# ATENCAO: NAO coloque credenciais reais ou de producao neste arquivo!
# Copie este arquivo para .env e preencha com seus valores locais.
# ===================================================================

# Conexao com o Banco de Dados (Substitua pelos dados do seu ambiente)
DB_URL=jdbc:postgresql://localhost:5432/secbot_db
DB_USERNAME=seu_usuario_db
DB_PASSWORD=sua_senha_db_aqui
DB_DRIVER=org.postgresql.Driver

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Seguranca / JWT
# ATENCAO: A chave secreta DEVE possuir no minimo 32 caracteres (256 bits)
JWT_SECRET=exemplo_chave_secreta_jwt_minimo_32_caracteres_secbot_dev!
JWT_EXPIRATION=36000000

